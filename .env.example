# Copy this file to .env and fill in the values.

# Where the N34 Mirissa app lives, relative to this folder. Playwright builds and starts it from here.
APP_DIR=../N34 Mirissa

# The app is started on its own port, so a dev server on 3000 (using the real database) is never reused by mistake.
BASE_URL=http://localhost:3100

# A SEPARATE Neon branch just for tests (e.g. a branch named "test"). Never the app's real DATABASE_URL:
# global setup wipes and re-seeds this database before each run.
TEST_DATABASE_URL=

# Any long random string, used by NextAuth to sign the test server's sessions.
AUTH_SECRET=

# The default staff login the app creates on an empty database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# true: wipe and re-seed the test database before the run. Set to false to keep the data between runs.
RESET_DB=true
