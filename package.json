{
  "name": "n34-mirissa-playwright-e2e",
  "version": "1.0.0",
  "description": "End-to-end UI automation framework for the N34 Mirissa beach hotel booking platform, using Playwright, TypeScript and the Page Object Model",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:admin": "playwright test --project=chromium --grep @admin",
    "test:settings": "playwright test --project=settings",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "pretest:allure": "node -e \"require('fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "test:allure": "allure run -- npx playwright test",
    "allure:generate": "allure generate ./allure-results",
    "allure:open": "allure open",
    "db:reset": "node scripts/reset-db.mjs --force",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "playwright",
    "e2e",
    "test-automation",
    "page-object-model",
    "typescript",
    "nextjs",
    "hotel-booking"
  ],
  "author": "Pubudu Gunawardhana",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-js-commons": "^3.15.0",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
